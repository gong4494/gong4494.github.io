{
  "name": "@cmdop/bot",
  "version": "2026.3.103",
  "description": "CMDOP multi-channel bot integrations — Telegram, Discord, Slack, Teams, and more",
  "author": "CMDOP <dev@cmdop.com>",
  "homepage": "https://cmdop.com/sdk/python/bot",
  "documentation": "https://cmdop.com/docs/sdk/node-bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/commandoperator/cmdop-sdk-js.git",
    "directory": "bot"
  },
  "bugs": {
    "url": "https://github.com/commandoperator/cmdop-sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@cmdop/node": "^2026.3.103",
    "consola": "^3.4.2",
    "zod": "^4"
  },
  "peerDependencies": {
    "@microsoft/teams.ai": ">=2.0",
    "@slack/bolt": ">=4.0",
    "discord.js": ">=14.0",
    "grammy": ">=1.30"
  },
  "peerDependenciesMeta": {
    "grammy": {
      "optional": true
    },
    "discord.js": {
      "optional": true
    },
    "@slack/bolt": {
      "optional": true
    },
    "@microsoft/teams.ai": {
      "optional": true
    }
  },
  "keywords": [
    "cmdop",
    "bot",
    "telegram",
    "discord",
    "slack",
    "teams",
    "agent",
    "terminal"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
