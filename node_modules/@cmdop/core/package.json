{
  "name": "@cmdop/core",
  "version": "2026.3.103",
  "description": "CMDOP SDK Core - Shared types, interfaces, and configuration",
  "author": "CMDOP <dev@cmdop.com>",
  "homepage": "https://cmdop.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/commandoperator/cmdop-sdk-js.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/commandoperator/cmdop-sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.3.4",
    "consola": "^3.4.2",
    "p-retry": "^7.1.1"
  },
  "keywords": [
    "cmdop",
    "sdk",
    "core",
    "types"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
