{
  "name": "@cmdop/node",
  "version": "2026.3.103",
  "description": "CMDOP SDK for Node.js - Server-side agent interaction via gRPC",
  "author": "CMDOP <dev@cmdop.com>",
  "homepage": "https://cmdop.com/sdk/node/",
  "documentation": "https://cmdop.com/docs/sdk/node/",
  "repository": {
    "type": "git",
    "url": "https://github.com/commandoperator/cmdop-sdk-js.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/commandoperator/cmdop-sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@cmdop/core": "^2026.3.103",
    "@grpc/grpc-js": "^1.12.0",
    "consola": "^3.4.2",
    "long": "^5.2.0",
    "nice-grpc": "^2.1.0",
    "nice-grpc-common": "^2.0.2",
    "zod": "^4"
  },
  "keywords": [
    "cmdop",
    "sdk",
    "node",
    "grpc",
    "terminal",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
